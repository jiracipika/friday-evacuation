[sub_resource type="GDScript" id="CameraFollow_1"]
script/source = "extends Camera3D
var target: Node3D = null
var enabled: bool = false

func _physics_process(delta):
	if enabled and target and is_instance_valid(target):
		var t = target.global_position + Vector3(0, 6, 10)
		global_position = global_position.lerp(t, delta * 5.0)
		look_at(target.global_position)
"

