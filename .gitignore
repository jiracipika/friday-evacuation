# Godot 4+ gitignore
.godot/
*.import

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Export builds
/builds/
*.exe
*.app
*.apk
*.aab
*.ipa

# graphify output (regenerable, machine-local)
graphify-out/
docs/ui-continuation/evidence/ladder-runs/

# Lightmap array importer settings are required to interpret baked EXR atlases.
!scenes/overhaul/baked/*.exr.import
