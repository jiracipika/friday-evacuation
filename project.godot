[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/physics_layer_1="world"
3d_physics/physics_layer_2="players"
3d_physics/physics_layer_3="items"

[physics]

3d/default_gravity=20.0

[importer_defaults]

texture={
"compress/mode": 2,
"compress/high_quality": false,
"mipmaps/generate": true
}

texture_etc2_astc={
"compress/mode": 2,
"mipmaps/generate": true
}

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.039, 0.039, 0.058, 1)
textures/default_filters/anisotropic_filtering_level=8
